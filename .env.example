APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://workspace:REPLACE@localhost:55432/workspace?sslmode=disable
DATABASE_PASSWORD=GENERATE
MFA_KEY=GENERATE_32_BYTE_HEX
OBJECT_USER=workspace-local
OBJECT_PASSWORD=GENERATE
SMTP_ADDR=localhost:51025
SMTP_FROM=security@workspace.invalid

OBJECT_ENDPOINT=http://localhost:59000
OBJECT_BUCKET=private-workspace

# Optional real educational models; keep secrets out of version control.
ACADEMIC_MODEL_PROVIDER=gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
