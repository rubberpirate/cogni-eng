# Copy to .env.production in the repository root. This file uses Bash syntax:
# single-quote values containing spaces, $, &, # or other shell characters.
APP_ENV=production
HTTP_ADDR=127.0.0.1:8080
# Your FRONTEND domain on Vercel, with no trailing slash.
PUBLIC_ORIGIN=https://learn.example.com

# Provision PostgreSQL and a private S3-compatible bucket before starting.
# URL-encode special characters in database usernames/passwords.
DATABASE_URL=''
# Optional separate migration owner; runtime processes do not receive this URL.
MIGRATION_DATABASE_URL=''
# Generate ONCE with: openssl rand -hex 32. Keep stable and back it up.
MFA_KEY=''
OBJECT_ENDPOINT=https://s3.example.com
OBJECT_BUCKET=private-workspace
OBJECT_USER=''
OBJECT_PASSWORD=''

# Production SMTP must support STARTTLS with a valid certificate.
SMTP_ADDR=smtp.example.com:587
SMTP_FROM=security@example.com
SMTP_USERNAME=''
SMTP_PASSWORD=''

# Optional AI generation: configure your selected provider on this server.
ACADEMIC_MODEL_PROVIDER=gemini
GEMINI_API_KEY=''
GEMINI_MODEL=gemini-flash-latest
OCR_PROVIDER=tesseract
OMR_MODEL_PROVIDER=bubble_classifier
# Bundled native OMRChecker: uv sync --project omr --frozen (no separate clone).
# Leave empty to use omr/engine, omr/.venv/bin/python and omr/bridge.py here.
OMRCHECKER_ROOT=''
OMRCHECKER_PYTHON=''
OMRCHECKER_ADAPTER=''
