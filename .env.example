APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://workspace:REPLACE@localhost:55432/workspace?sslmode=disable
DATABASE_PASSWORD=GENERATE
MFA_KEY=GENERATE_32_BYTE_HEX
OBJECT_USER=workspace-local
OBJECT_PASSWORD=GENERATE
SMTP_ADDR=localhost:51025
SMTP_FROM=security@workspace.invalid

OBJECT_ENDPOINT=http://localhost:59000
OBJECT_BUCKET=private-workspace

# Optional real educational models; keep secrets out of version control.
ACADEMIC_MODEL_PROVIDER=local
LOCAL_MODEL_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=qwen3.5:9b-q4_K_M
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Explicit development-only alternative: ACADEMIC_MODEL_PROVIDER=development_fixture

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional private GPU inference runtime: bun run vision
OCR_PROVIDER=tesseract
OMR_MODEL_PROVIDER=bubble_classifier
VISION_BASE_URL=http://127.0.0.1:58010/v1
VISION_API_KEY=
# Optional development autostart after the frozen runtime is installed
VISION_AUTOSTART=0
